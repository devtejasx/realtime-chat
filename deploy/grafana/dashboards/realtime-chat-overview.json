    {
      "type": "timeseries",
      "title": "Cluster messages/sec",
      "description": "What one instance publishes must show up as received on the others. Published climbing while received stays flat is how a dead bus - or instances pointed at different Redis databases - announces itself.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
