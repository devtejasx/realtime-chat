# -----------------------------------------------------------------------------
# realtime-chat — environment configuration (Phase 1)
#
# Copy this file to `.env` and adjust for your environment.
# All variables have sensible development defaults baked into the Config class;
# override them here for staging/production.
# -----------------------------------------------------------------------------

# HTTP server
CHAT_PORT=8080

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=realtime_chat
DB_USER=chat
DB_PASSWORD=chat_password

# Connection pool sizing (optional, defaults applied if unset)
DB_POOL_SIZE=8

# JWT signing
# IMPORTANT: use a long, random secret in production (>= 32 bytes).
JWT_SECRET=dev-insecure-secret-change-me-in-production
# Access token lifetime in seconds (default 900 = 15 minutes)
JWT_ACCESS_TTL_SECONDS=900
# Refresh token lifetime in seconds (default 1209600 = 14 days)
JWT_REFRESH_TTL_SECONDS=1209600
# Token issuer claim
JWT_ISSUER=realtime-chat

# Logging: trace | debug | info | warn | error | critical | off
LOG_LEVEL=info

# Deployment environment label (surfaced by /health)
APP_ENV=development
