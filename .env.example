# -----------------------------------------------------------------------------
# realtime-chat — environment configuration (Phase 1)
#
# Copy this file to `.env` and adjust for your environment.
# All variables have sensible development defaults baked into the Config class;
# override them here for staging/production.
# -----------------------------------------------------------------------------

# HTTP server
CHAT_PORT=8080

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=realtime_chat
DB_USER=chat
DB_PASSWORD=chat_password

# Connection pool sizing (optional, defaults applied if unset)
DB_POOL_SIZE=8

# JWT signing
# IMPORTANT: use a long, random secret in production (>= 32 bytes).
JWT_SECRET=dev-insecure-secret-change-me-in-production
# Access token lifetime in seconds (default 900 = 15 minutes)
JWT_ACCESS_TTL_SECONDS=900
# Refresh token lifetime in seconds (default 1209600 = 14 days)
JWT_REFRESH_TTL_SECONDS=1209600
# Token issuer claim
JWT_ISSUER=realtime-chat

# WebSocket heartbeat (seconds). Server pings every INTERVAL; a connection idle
# for longer than TIMEOUT is closed. TIMEOUT must be >= INTERVAL.
WS_HEARTBEAT_INTERVAL_SECONDS=30
WS_HEARTBEAT_TIMEOUT_SECONDS=90

# -----------------------------------------------------------------------------
# Phase 3: scalability & production
# -----------------------------------------------------------------------------

# Redis (distributed cache/sessions/presence). Requires a build with
# -DRTC_WITH_REDIS=ON; otherwise the in-memory store is used regardless.
REDIS_ENABLED=false
REDIS_URL=tcp://127.0.0.1:6379
CACHE_USER_TTL_SECONDS=300
CACHE_CONVERSATION_TTL_SECONDS=60

# File uploads / attachments
UPLOAD_DIR=uploads
UPLOAD_PUBLIC_BASE_URL=/api/attachments
MAX_UPLOAD_BYTES=26214400      # 25 MiB
MAX_REQUEST_BYTES=1048576      # 1 MiB (JSON bodies)

# Rate limiting (fixed window)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_MESSAGE_MAX=120
RATE_LIMIT_UPLOAD_MAX=30
RATE_LIMIT_DEFAULT_MAX=300

# Security
CORS_ALLOWED_ORIGINS=*

# Background workers
WORKER_THREADS=2
MAINTENANCE_INTERVAL_SECONDS=60

# Logging: trace | debug | info | warn | error | critical | off
LOG_LEVEL=info
# Log output format: text (human-readable) | json (structured, for production)
LOG_FORMAT=text

# Deployment environment label (surfaced by /health)
APP_ENV=development
