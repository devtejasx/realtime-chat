# -----------------------------------------------------------------------------
# realtime-chat — environment configuration (Phase 1)
#
# Copy this file to `.env` and adjust for your environment.
# All variables have sensible development defaults baked into the Config class;
# override them here for staging/production.
# -----------------------------------------------------------------------------

# HTTP server
CHAT_PORT=8080

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=realtime_chat
DB_USER=chat
DB_PASSWORD=chat_password

# Connection pool sizing (optional, defaults applied if unset)
DB_POOL_SIZE=8

# JWT signing
# IMPORTANT: use a long, random secret in production (>= 32 bytes).
JWT_SECRET=dev-insecure-secret-change-me-in-production
# Access token lifetime in seconds (default 900 = 15 minutes)
JWT_ACCESS_TTL_SECONDS=900
# Refresh token lifetime in seconds (default 1209600 = 14 days)
JWT_REFRESH_TTL_SECONDS=1209600
# Token issuer claim
JWT_ISSUER=realtime-chat

# WebSocket heartbeat (seconds). Server pings every INTERVAL; a connection idle
# for longer than TIMEOUT is closed. TIMEOUT must be >= INTERVAL.
WS_HEARTBEAT_INTERVAL_SECONDS=30
WS_HEARTBEAT_TIMEOUT_SECONDS=90

# -----------------------------------------------------------------------------
# Phase 3: scalability & production
# -----------------------------------------------------------------------------

# Redis (distributed cache/sessions/presence). Requires a build with
# -DRTC_WITH_REDIS=ON; otherwise the in-memory store is used regardless.
REDIS_ENABLED=false
REDIS_URL=tcp://127.0.0.1:6379
CACHE_USER_TTL_SECONDS=300
CACHE_CONVERSATION_TTL_SECONDS=60

# File uploads / attachments
UPLOAD_DIR=uploads
UPLOAD_PUBLIC_BASE_URL=/api/attachments
MAX_UPLOAD_BYTES=26214400      # 25 MiB
MAX_REQUEST_BYTES=1048576      # 1 MiB (JSON bodies)

# Rate limiting (fixed window)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_MESSAGE_MAX=120
RATE_LIMIT_UPLOAD_MAX=30
RATE_LIMIT_DEFAULT_MAX=300

# Security
CORS_ALLOWED_ORIGINS=*

# Background workers
WORKER_THREADS=2
MAINTENANCE_INTERVAL_SECONDS=60

# Logging: trace | debug | info | warn | error | critical | off
LOG_LEVEL=info
# Log output format: text (human-readable) | json (structured, for production)
LOG_FORMAT=text

# Deployment environment label (surfaced by /health)
APP_ENV=development

# -----------------------------------------------------------------------------
# Phase 5: enterprise platform
# -----------------------------------------------------------------------------

# --- Horizontal scaling ------------------------------------------------------
# Cross-instance WebSocket fan-out over Redis Pub/Sub. REQUIRED once more than one
# replica serves traffic: a connection is pinned to the instance that accepted it,
# so without this a message persisted on one instance never reaches a recipient
# connected to another. Startup fails if this is set without REDIS_ENABLED.
# Defaults to whatever REDIS_ENABLED is.
CLUSTER_ENABLED=false

# Stable identity for this process, stamped on cluster messages and on the
# service.instance.id trace attribute. Kubernetes sets it from the pod name; falls
# back to HOSTNAME, then to a random token.
# RTC_NODE_ID=

# --- Authorization -----------------------------------------------------------
# How long a role or suspension decision may be cached. This is the worst-case
# delay before a ban or demotion takes effect, so keep it short.
AUTHZ_CACHE_TTL_SECONDS=30

# --- Distributed tracing (OpenTelemetry-compatible) --------------------------
TRACING_ENABLED=false
# logging | otlp | zipkin
#   logging — one structured log record per span; no network dependency
#   otlp    — OTLP/HTTP JSON to an OpenTelemetry Collector, Jaeger >= 1.35 or Tempo
#   zipkin  — Zipkin v2 JSON
TRACING_EXPORTER=logging
# Defaults per format: OTLP :4318/v1/traces, Zipkin :9411/api/v2/spans
TRACING_ENDPOINT=http://127.0.0.1:4318/v1/traces
# Head-based sampling for root spans, 0.0-1.0. A span inheriting a sampled parent
# is always recorded, so a distributed trace is never captured in fragments.
# 5% keeps volume affordable; use 1.0 in staging.
TRACING_SAMPLE_RATIO=0.05

# --- Feature flags -----------------------------------------------------------
# Runtime-togglable capabilities. All default on, so leaving them unset preserves
# existing behaviour exactly. A super admin can flip one at runtime via
# PUT /api/v1/admin/features/<name>; that applies to one instance and is not
# persisted, so change it here for a durable rollout.
ENABLE_REACTIONS=true
ENABLE_UPLOADS=true
ENABLE_NOTIFICATIONS=true
ENABLE_TYPING=true
ENABLE_SEARCH=true
ENABLE_READ_RECEIPTS=true
ENABLE_PRESENCE=true
ENABLE_AUDIT_LOG=true

# --- API documentation -------------------------------------------------------
# Serves /docs (Swagger UI) and /openapi.json. Set to false to switch both off
# without a rebuild.
RTC_DOCS_ENABLED=true
