# ---------------------------------------------------------------------------
# PostgreSQL (RDS) and its credentials.
# ---------------------------------------------------------------------------

resource "aws_db_subnet_group" "main" {
  name        = "${local.name_prefix}-db"
  description = "Database tier subnets for ${local.name_prefix}"
  subnet_ids  = aws_subnet.database[*].id

  tags = { Name = "${local.name_prefix}-db-subnet-group" }
}

# Password generated by Terraform and stored in Secrets Manager rather than taken
# as a variable. A variable would land in the plan output, in shell history, and in
# any CI log that echoes it — and a `sensitive` marking does not stop it appearing
# in state. Generating it here means no human ever sees or handles it.
#
# `random_password` *is* recorded in state, so state must be encrypted and access
# controlled (see the backend block in versions.tf).
resource "random_password" "db" {
  length = 32
  # RDS rejects '/', '@', '"' and space in a master password.
  override_special = "!#$%&*()-_=+[]{}<>:?"
  special          = true
}

resource "aws_secretsmanager_secret" "db" {
  name        = "${local.name_prefix}/database"
  description = "PostgreSQL credentials for ${local.name_prefix}"

  # Zero-day recovery so `terraform destroy` followed by re-apply does not collide
  # with a soft-deleted secret of the same name. Raise this in production, where an
  # accidental deletion should be recoverable.
  recovery_window_in_days = 0

  tags = { Name = "${local.name_prefix}-db-secret" }
}

resource "aws_secretsmanager_secret_version" "db" {
  secret_id = aws_secretsmanager_secret.db.id

  # Stored in the shape the application's environment expects, so the bootstrap
  # script can map it to DB_* variables without transformation.
  secret_string = jsonencode({
    DB_HOST     = aws_db_instance.main.address
    DB_PORT     = tostring(aws_db_instance.main.port)
    DB_NAME     = var.db_name
    DB_USER     = var.db_username
    DB_PASSWORD = random_password.db.result
  })
}

# JWT signing key, generated the same way and for the same reasons. Config
# validation refuses to boot in production with anything under 32 bytes.
resource "random_password" "jwt_secret" {
  length  = 64
  special = false # base64-safe; avoids quoting problems in shell and systemd units
}

resource "aws_secretsmanager_secret" "app" {
  name                    = "${local.name_prefix}/application"
  description             = "Application secrets for ${local.name_prefix}"
  recovery_window_in_days = 0

  tags = { Name = "${local.name_prefix}-app-secret" }
}

resource "aws_secretsmanager_secret_version" "app" {
  secret_id = aws_secretsmanager_secret.app.id

  secret_string = jsonencode({
    JWT_SECRET = random_password.jwt_secret.result
  })
}

# --- Parameter group -------------------------------------------------------

resource "aws_db_parameter_group" "main" {
  name        = "${local.name_prefix}-pg16"
  family      = "postgres16"
  description = "Tuned parameters for ${local.name_prefix}"

  # Force TLS. Without this, libpq happily connects in clear text and every query —
  # including credentials in the connection string — crosses the VPC unencrypted.
  parameter {
    name  = "rds.force_ssl"
    value = "1"
  }

  # Log statements slower than 500 ms. Cheap, and it is the single most useful
  # signal when the API's p99 latency drifts.
  parameter {
    name  = "log_min_duration_statement"
    value = "500"
  }

  parameter {
    name  = "log_connections"
    value = "1"
  }

  parameter {
    name  = "log_disconnections"
    value = "1"
  }

  # pg_stat_statements: required to answer "which query is slow?" after the fact.
  # Loading a shared library needs a reboot, hence pending-reboot.
  parameter {
    name         = "shared_preload_libraries"
    value        = "pg_stat_statements"
    apply_method = "pending-reboot"
  }

  lifecycle {
    create_before_destroy = true
  }
}

# --- Instance --------------------------------------------------------------

resource "aws_db_instance" "main" {
  identifier = "${local.name_prefix}-postgres"

  engine = "postgres"
  # Major version pinned, minor upgrades automatic: security patches land without
  # intervention, while a major upgrade (which can break compatibility) stays a
  # deliberate decision.
  engine_version              = "16"
  allow_major_version_upgrade = false
  auto_minor_version_upgrade  = true

  instance_class = var.db_instance_class

  # gp3 over gp2: baseline IOPS are independent of volume size, so a small database
  # is not also a slow one.
  storage_type          = "gp3"
  allocated_storage     = var.db_allocated_storage
  max_allocated_storage = var.db_max_allocated_storage
  storage_encrypted     = true

  db_name  = var.db_name
  username = var.db_username
  password = random_password.db.result
  port     = 5432

  db_subnet_group_name   = aws_db_subnet_group.main.name
  vpc_security_group_ids = [aws_security_group.database.id]
  parameter_group_name   = aws_db_parameter_group.main.name
  # Never publicly addressable. The security group would block it anyway; this is
  # defence in depth against a security-group mistake.
  publicly_accessible = false

  multi_az = var.db_multi_az

  backup_retention_period = var.db_backup_retention_days
  # Backup and maintenance windows placed in the quietest period, and separated so
  # they cannot overlap.
  backup_window      = "03:00-04:00"
  maintenance_window = "sun:04:30-sun:05:30"
  copy_tags_to_snapshot   = true
  delete_automated_backups = false

  # Slow-query and error logs into CloudWatch, so diagnostics survive the instance.
  enabled_cloudwatch_logs_exports = ["postgresql", "upgrade"]

  performance_insights_enabled          = true
  performance_insights_retention_period = 7
  monitoring_interval                   = 60
  monitoring_role_arn                   = aws_iam_role.rds_monitoring.arn

  deletion_protection = var.db_deletion_protection
  # Take a final snapshot on delete. `skip_final_snapshot = true` is a one-keystroke
  # route to unrecoverable data loss.
  skip_final_snapshot       = false
  final_snapshot_identifier = "${local.name_prefix}-postgres-final"

  apply_immediately = false

  tags = { Name = "${local.name_prefix}-postgres" }

  lifecycle {
    # The generated password is authoritative in Secrets Manager. Ignoring drift
    # here means an out-of-band rotation does not cause Terraform to reset it back.
    ignore_changes = [password]
  }
}

resource "aws_iam_role" "rds_monitoring" {
  name = "${local.name_prefix}-rds-monitoring"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "monitoring.rds.amazonaws.com" }
      Action    = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "rds_monitoring" {
  role       = aws_iam_role.rds_monitoring.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonRDSEnhancedMonitoringRole"
}
