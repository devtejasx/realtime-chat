# =============================================================================
# Template for local configuration. Copy to `.env`, adjust, and load it into
# your shell (Docker Compose will do this automatically in Milestone 12).
# The application itself reads ONLY real environment variables — it does not
# parse this file. `.env` is gitignored because later milestones add secrets.
# =============================================================================

# Deployment stage: development | test | production
CHAT_ENVIRONMENT=development

# Bind address. 0.0.0.0 = all interfaces (required inside Docker);
# 127.0.0.1 restricts to local-only access.
CHAT_HOST=0.0.0.0

# HTTP + WebSocket listener port.
CHAT_PORT=8080

# Crow worker-thread pool size. Unset = number of hardware threads.
CHAT_WORKER_THREADS=4

# Minimum log severity: debug | info | warning | error | critical
CHAT_LOG_LEVEL=info
