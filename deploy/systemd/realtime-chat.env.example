# Environment file for the systemd service (/etc/realtime-chat/realtime-chat.env).
# Copy, then restrict permissions: chmod 600 and chown root:root.
# See .env.example for the complete list of variables.

CHAT_PORT=8080

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=realtime_chat
DB_USER=chat
DB_PASSWORD=CHANGE_ME
DB_POOL_SIZE=16

REDIS_ENABLED=true
REDIS_URL=tcp://127.0.0.1:6379

# Use a long, random value (e.g. `openssl rand -hex 32`).
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

APP_ENV=production
LOG_LEVEL=info
LOG_FORMAT=json

CORS_ALLOWED_ORIGINS=https://app.example.com
UPLOAD_DIR=/var/lib/realtime-chat/uploads
MIGRATIONS_DIR=/opt/realtime-chat/migrations
