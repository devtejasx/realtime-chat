# Normalize line endings to LF in the repository
* text=auto eol=lf

# Explicit source types
*.cc   text eol=lf
*.cpp  text eol=lf
*.h    text eol=lf
*.hpp  text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.sql  text eol=lf
*.md   text eol=lf
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Binary assets
*.png  binary
*.jpg  binary
*.ico  binary
